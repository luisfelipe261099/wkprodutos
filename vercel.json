{
  "version": 2,
  "builds": [
    { "src": "api/index.php", "use": "vercel-php@0.9.0", "config": { "includeFiles": "**" } },
    { "src": "css/**", "use": "@vercel/static" },
    { "src": "js/**", "use": "@vercel/static" },
    { "src": "img/**", "use": "@vercel/static" },
    { "src": "*.png", "use": "@vercel/static" },
    { "src": "*.jpg", "use": "@vercel/static" },
    { "src": "*.ico", "use": "@vercel/static" },
    { "src": "*.svg", "use": "@vercel/static" },
    { "src": "*.webp", "use": "@vercel/static" },
    { "src": "robots.txt", "use": "@vercel/static" },
    { "src": "sitemap.xml", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/css/(.*)", "dest": "/css/$1" },
    { "src": "/js/(.*)",  "dest": "/js/$1"  },
    { "src": "/img/(.*)", "dest": "/img/$1" },
    { "src": "/uploads/(.*)", "dest": "/uploads/$1" },
    { "src": "/logo\\.png", "dest": "/logo.png" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/api/index.php" }
  ]
}
